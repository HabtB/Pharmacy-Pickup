# === Flutter App (.env) ===

# Grok API Key — used for LLM medication parsing fallback
GROK_API_KEY=your-api-key-here

# Server URL — set for production (skips LAN scanning)
# Leave empty for local development (auto-discovers on LAN)
SERVER_URL=

# Docling Server URL (initial fallback in OCR service)
DOCLING_SERVER_URL=http://localhost:5003

# === Python Server (python_server/.env) ===

# Google Cloud Vision credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Gemini API Key (used by floor_stock_parser for table parsing)
# GEMINI_API_KEY=your-gemini-key

# JWT secret — tokens are invalidated on server restart without this
# JWT_SECRET=generate-with-python-secrets-token_hex-32

# Login credentials
# ADMIN_PASSWORD=change-me
# PICKER_PASSWORD=change-me

# Grok API Configuration
# Replace 'your-api-key-here' with your actual API key from https://x.ai/api
GROK_API_KEY=your-api-key-here

# Server URL — set this for production (skips local network scanning)
# Leave empty or omit for local development (auto-discovers on LAN)
# Example: SERVER_URL=https://your-backend.example.com
SERVER_URL=

# Docling Server URL (legacy — used as initial fallback in OCR service)
DOCLING_SERVER_URL=http://localhost:5003
